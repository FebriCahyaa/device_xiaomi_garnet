<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy this file to .repo/local_manifests/garnet.xml in your LineageOS 24.0
  workspace before running breakfast. It pins the FebriCahyaa forks that make
  up the garnet 6.6 build; lineage.dependencies only resolves LineageOS-owned
  repositories and cannot point at a different GitHub account.
-->
<manifest>
    <remote name="febri" fetch="https://github.com/FebriCahyaa" />

    <project path="device/xiaomi/garnet"
             name="device_xiaomi_garnet"
             remote="febri"
             revision="garnet-6.6" />

    <project path="vendor/xiaomi/garnet"
             name="vendor_xiaomi_garnet"
             remote="febri"
             revision="garnet-6.6" />

    <project path="kernel/xiaomi/sm7435"
             name="android_kernel_xiaomi_garnet_6.6"
             remote="febri"
             revision="garnet-6.6" />

    <project path="kernel/xiaomi/sm7435-devicetrees"
             name="android_kernel_xiaomi_sm7435-devicetrees"
             remote="febri"
             revision="garnet-6.6" />

    <project path="kernel/xiaomi/sm7435-modules"
             name="android_kernel_xiaomi_sm7435-modules"
             remote="febri"
             revision="garnet-6.6" />

    <project path="packages/apps/XiaomiParts"
             name="packages_apps_XiaomiParts"
             remote="febri"
             revision="garnet-6.6" />
</manifest>
