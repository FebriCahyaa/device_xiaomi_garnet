# XiaomiParts runs as system_app: platform-signed, privileged, system_ext,
# and shares android.uid.system. It manages charging, display, CPU and GPU
# tuning through the sysfs nodes exposed by our 6.6 kernel and modules.
#
# AOSP system_app.te does not grant sysfs write access by default and no
# neverallow forbids this. Labels are kept narrow in genfs_contexts below so
# only the tunables XiaomiParts actually uses are writable by system_app.

allow system_app xiaomi_parts_sysfs:dir r_dir_perms;
allow system_app xiaomi_parts_sysfs:file rw_file_perms;
allow system_app xiaomi_parts_sysfs:lnk_file r_file_perms;

# VM tunables used by UMM Tier 2. Not under /sys.
allow system_app xiaomi_parts_proc_vm:file rw_file_perms;

# /sys/block/zram0 and /sys/kernel/dmabuf are read-only reporting nodes.
allow system_app sysfs_zram:dir r_dir_perms;
allow system_app sysfs_zram:file r_file_perms;
