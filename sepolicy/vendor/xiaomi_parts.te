# XiaomiParts runs as system_app: platform-signed, privileged, system_ext,
# and shares android.uid.system. It manages charging, display, CPU and GPU
# tuning through the sysfs nodes exposed by our 6.6 kernel and modules.
#
# AOSP system_app.te does not grant sysfs write access by default and no
# neverallow forbids it for system_app, so these rules are scoped to that one
# domain. init/target rc sets the file ownership and mode; SELinux only needs
# to permit the opens and writes.

allow system_app sysfs:dir r_dir_perms;
allow system_app sysfs:file rw_file_perms;
allow system_app sysfs:lnk_file r_file_perms;

# Specific labels used by Qualcomm / Xiaomi nodes that would otherwise be
# denied even with the generic sysfs grant above.
allow system_app sysfs_devices_system_cpu:dir r_dir_perms;
allow system_app sysfs_devices_system_cpu:file rw_file_perms;
allow system_app sysfs_thermal:dir r_dir_perms;
allow system_app sysfs_thermal:file rw_file_perms;
allow system_app vendor_sysfs_qcom_battery:dir r_dir_perms;
allow system_app vendor_sysfs_qcom_battery:file rw_file_perms;
allow system_app vendor_sysfs_kgsl:dir r_dir_perms;
allow system_app vendor_sysfs_kgsl:file rw_file_perms;
allow system_app vendor_sysfs_graphics:dir r_dir_perms;
allow system_app vendor_sysfs_graphics:file rw_file_perms;
